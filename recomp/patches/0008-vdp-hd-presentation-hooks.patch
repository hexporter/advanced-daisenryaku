+/* Optional presentation hooks, set by the game (HD frame only; the 1x frame,
+ * collision and status flags never see them). Per HD line:
+ *  - sprite(user, &x, y, size, attr) for every sprite on the line (screen x/y
+ *    of its top-left, SAT size byte, attribute word); non-zero = leave it out of
+ *    the HD frame; it may change x to draw the sprite elsewhere on the line. Either
+ *    way the sprite still counts for the per-line limits at its real position.
+ *  - layers(user, v, line, scale, width, a, b, row_stride) after planes A and B
+ *    (window included in a) are sampled: scale rows of width*scale bytes each,
+ *    row r at a + r*row_stride, byte = priority<<7 | opaque<<6 | palette<<4 |
+ *    colour. The hook may rewrite them; sprites and shadow/highlight are composed
+ *    on top as usual. */
+typedef int  (*GvdpHdSpriteHook)(void *user, int *x, int y, unsigned size, unsigned attr);
+typedef void (*GvdpHdLayerHook)(void *user, const GVDP *v, int line, unsigned scale, int width,
+                                uint8_t *a, uint8_t *b, int row_stride);
+void     gvdp_hd_set_hooks(GvdpHdLayerHook layers, GvdpHdSpriteHook sprite, void *user);
+
