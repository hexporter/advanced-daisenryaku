--- a/runner/main.c
+++ b/runner/main.c
@@ -2421,6 +2421,8 @@ static void replay_view(GenesisReplayView *v,int apply)
     }
 }
 
+volatile double g_game_ff_request = 0.0;   /* game_spec.h */
+
 int main(int argc, char *argv[])
 {
     init_exe_dir(argv[0]);
@@ -3705,6 +3707,9 @@ session_begin:;
             double x = rt <= 2000 ? 0.0 : (double)(rt - 2000) / 30767.0;
             if (x > 1.0) x = 1.0;
             ff_speed = 1.0 + (ff_max - 1.0) * x * x;
+            { double req = g_game_ff_request;
+              if (req > ff_max) req = ff_max;
+              if (req > ff_speed) ff_speed = req; }
             if (turbo || runtime_measure_frames) ff_speed = 1.0;
 #if GENESIS_HAS_RECOMP_NET
             if (genesis_netplay_active()) ff_speed = 1.0;
