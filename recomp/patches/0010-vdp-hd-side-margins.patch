+
+/* Side margins of the HD frame: `px` extra screen pixels (1x) left and right of
+ * the picture, 0 = none (default), at most GVDP_HD_MAX_MARGIN. With a margin,
+ * gvdp_render_scanline_hd returns rows of (width + 2*px) * scale indices with the
+ * picture in the middle. The margin hook is called per HD line after the layer
+ * hook: left_a/left_b/right_a/right_b each hold scale rows of px*scale bytes
+ * (row r at +r*row_stride, cleared, encoding as in the layer hook). Non-zero
+ * return = the margins of this line are composed like planes (backdrop,
+ * shadow/highlight, no sprites) and gvdp_hd_margin_drawn() is 1; otherwise the
+ * caller paints them black. */
+#define GVDP_HD_MAX_MARGIN 48
+typedef int (*GvdpHdMarginHook)(void *user, const GVDP *v, int line, unsigned scale, int margin,
+                                uint8_t *left_a, uint8_t *left_b,
+                                uint8_t *right_a, uint8_t *right_b, int row_stride);
+void     gvdp_hd_set_margin(int px);
+int      gvdp_hd_margin(void);
+void     gvdp_hd_set_margin_hook(GvdpHdMarginHook hook, void *user);
+int      gvdp_hd_margin_drawn(void);            /* for the line rendered last */
 
