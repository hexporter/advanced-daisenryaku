+
+/* Bit counts for the HD tile matching; MSVC has no __builtin_popcount/ctz/clz. Arguments are
+ * never 0 where ctz/clz are used (callers checked popcount == 2 first). */
+#if defined(_MSC_VER) && !defined(__clang__)
+#include <intrin.h>
+static int hd_popcount(unsigned v)
+{
+    v = v - ((v >> 1) & 0x55555555u);
+    v = (v & 0x33333333u) + ((v >> 2) & 0x33333333u);
+    return (int)((((v + (v >> 4)) & 0x0F0F0F0Fu) * 0x01010101u) >> 24);
+}
+static int hd_ctz(unsigned v) { unsigned long i; _BitScanForward(&i, v); return (int)i; }
+static int hd_clz(unsigned v) { unsigned long i; _BitScanReverse(&i, v); return 31 - (int)i; }
+#else
+#define hd_popcount(v) __builtin_popcount(v)
+#define hd_ctz(v)      __builtin_ctz(v)
+#define hd_clz(v)      __builtin_clz(v)
+#endif
 
