 extern uint32_t g_hd_frame[GENESIS_HD_STRIDE * GENESIS_HD_ROWS];
 extern int g_hd_frame_w, g_hd_frame_h, g_hd_frame_request;
 
+/* Side margins of the HD frame in colour: on every HD row whose margins the
+ * VDP margin hook (gvdp_hd_set_margin_hook) did not draw, the hook may write
+ * ARGB8888 pixels straight into the frame: `px` pixels at `left` and at
+ * `right` (black on entry). `line` is the screen line, `sub` the HD row within
+ * it (0..scale-1). For art that is not made of the game's palette. */
+typedef void (*GenesisHdMarginArgbHook)(void *user, const GVDP *v, int line, int sub, int scale,
+                                        int px, uint32_t *left, uint32_t *right);
+void genesis_hd_set_margin_argb_hook(GenesisHdMarginArgbHook hook, void *user);
