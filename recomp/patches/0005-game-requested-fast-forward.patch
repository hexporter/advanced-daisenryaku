diff --git a/runner/game_spec.h b/runner/game_spec.h
index a135a9b..784a75f 100644
--- a/runner/game_spec.h
+++ b/runner/game_spec.h
@@ -303,3 +303,11 @@ typedef struct GameSpec {
  * link time; game-specific implementation belongs in the game repository.
  */
 extern const GameSpec g_game_spec;
+
+/*
+ * Fast-forward requested by game code, e.g. from an instruction hook while a
+ * CPU opponent is thinking: guest frames per presented frame, <= 1 = none.
+ * The runner takes the larger of this and the right-trigger speed, capped at
+ * GENESIS_FF_MAX, with the same exclusions (turbo, netplay, measurement).
+ */
+extern volatile double g_game_ff_request;
diff --git a/runner/main.c b/runner/main.c
